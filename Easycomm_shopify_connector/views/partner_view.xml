<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Form View - Add Shopify Tab -->
    <record id="view_partner_form_shopify" model="ir.ui.view">
        <field name="name">res.partner.form.shopify</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-shopping-cart"
                        name="action_open_shopify_customer_sync_wizard" type="object"
                        invisible="not is_shopify_customer and not shopify_instance_id">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="shopify_total_spent" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">Shopify Sales</span>
                    </div>
                </button>
                <button class="oe_stat_button" icon="fa-file-text-o"
                        name="action_open_shopify_customer_sync_wizard" type="object"
                        invisible="not is_shopify_customer and not shopify_instance_id">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="shopify_orders_count" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">Shopify Orders</span>
                    </div>
                </button>
            </xpath>
            <!-- Shopify store (domain) shown right below the Tags field -->
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="shopify_company" readonly="1" invisible="not shopify_instance_id"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Shopify" name="shopify">
                    <div class="alert alert-success" role="alert" invisible="not shopify_customer_id">
                        This customer is linked to Shopify. Click <b>Sync to Shopify</b> to push the latest changes.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="shopify_customer_id">
                        This customer is <b>not on Shopify yet</b>. Click <b>Sync to Shopify</b>, pick the store
                        (instance), and it will be created there.
                    </div>
                    <button name="action_open_shopify_customer_sync_wizard" type="object"
                            string="Sync to Shopify" class="btn-primary" icon="fa-shopping-cart"/>
                    <group>
                        <group string="Identity">
                            <field name="is_shopify_customer"/>
                            <field name="shopify_instance_id"/>
                            <field name="shopify_customer_id" readonly="1"/>
                            <field name="shopify_state"/>
                            <field name="shopify_customer_tags"/>
                            <field name="shopify_currency" readonly="1"/>
                            <field name="shopify_tax_exempt"/>
                        </group>
                        <group string="Sales Statistics">
                            <field name="shopify_orders_count" readonly="1" string="Total Orders"/>
                            <field name="shopify_total_spent" readonly="1" string="Total Sales"/>
                            <field name="shopify_last_order_name" readonly="1"/>
                            <field name="shopify_last_order_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Marketing">
                            <field name="shopify_email_verified"/>
                            <field name="shopify_accepts_marketing"/>
                            <field name="shopify_email_marketing_state" readonly="1"/>
                            <field name="shopify_sms_marketing_state" readonly="1"/>
                        </group>
                        <group string="Sync Information">
                            <field name="shopify_created_at" readonly="1"/>
                            <field name="shopify_updated_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Shopify Note" invisible="not shopify_note">
                        <field name="shopify_note" nolabel="1"/>
                    </group>
                    <group string="Raw Data (every key from Shopify)" invisible="not shopify_raw_data">
                        <field name="shopify_raw_data" readonly="1" widget="text" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Partner List View - Add Shopify Fields -->
    <record id="view_partner_list_shopify" model="ir.ui.view">
        <field name="name">res.partner.list.shopify</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="is_shopify_customer" optional="hide"/>
                <field name="shopify_customer_id" optional="hide"/>
                <field name="shopify_instance_id" optional="hide"/>
                <field name="shopify_orders_count" string="Total Orders" optional="show"/>
                <field name="shopify_total_spent" string="Total Sales" optional="show"/>
                <field name="shopify_customer_tags" string="Shopify Tags" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Partner Search View - Add Shopify Filters -->
    <record id="view_partner_search_shopify" model="ir.ui.view">
        <field name="name">res.partner.search.shopify</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter string="Shopify Customers" name="shopify_customers" domain="[('is_shopify_customer', '=', True)]"/>
                <filter string="Non-Shopify Customers" name="non_shopify_customers" domain="[('is_shopify_customer', '=', False)]"/>
                <separator/>
                <field name="shopify_instance_id"/>
                <field name="shopify_customer_id"/>
            </xpath>
        </field>
    </record>

    <!-- Shopify Customers Action -->
    <record id="action_shopify_customer" model="ir.actions.act_window">
        <field name="name">Shopify Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_shopify_customer', '=', True)]</field>
        <field name="context">{'search_default_shopify_customers': 1}</field>
    </record>

</odoo>
