<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Server Action: Register All Webhooks (Action menu on list view) ── -->
    <record id="action_server_register_all_webhooks" model="ir.actions.server">
        <field name="name">Register All Webhooks</field>
        <field name="model_id" ref="model_shopify_webhook"/>
        <field name="binding_model_id" ref="model_shopify_webhook"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env['shopify.webhook'].action_register_all()</field>
    </record>

    <!-- ── Server Action: Delete All Webhooks (Action menu on list view) ─── -->
    <record id="action_server_delete_all_webhooks" model="ir.actions.server">
        <field name="name">Delete All Webhooks</field>
        <field name="model_id" ref="model_shopify_webhook"/>
        <field name="binding_model_id" ref="model_shopify_webhook"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env['shopify.webhook'].action_delete_all()</field>
    </record>

    <!-- Webhook List View -->
    <record id="view_shopify_webhook_list" model="ir.ui.view">
        <field name="name">shopify.webhook.list</field>
        <field name="model">shopify.webhook</field>
        <field name="arch" type="xml">
            <list string="Shopify Webhooks">
                <field name="name"/>
                <field name="shopify_instance_id"/>
                <field name="topic"/>
                <field name="webhook_url"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="shopify_webhook_id"/>
            </list>
        </field>
    </record>

    <!-- Webhook Form View -->
    <record id="view_shopify_webhook_form" model="ir.ui.view">
        <field name="name">shopify.webhook.form</field>
        <field name="model">shopify.webhook</field>
        <field name="arch" type="xml">
            <form string="Shopify Webhook">
                <header>
                    <button name="create_webhook_in_shopify" type="object"
                            string="Create in Shopify"
                            class="oe_highlight"
                            invisible="shopify_webhook_id"/>
                    <button name="button_register_all_for_instance" type="object"
                            string="Register All for This Instance"
                            invisible="not shopify_instance_id"
                            confirm="This will register all default webhook topics for the selected Shopify instance. Continue?"/>
                    <button name="delete_webhook_from_shopify" type="object"
                            string="Delete from Shopify"
                            confirm="Are you sure you want to delete this webhook from Shopify?"
                            invisible="not shopify_webhook_id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="shopify_instance_id"/>
                            <field name="topic"/>
                        </group>
                        <group>
                            <field name="webhook_url"/>
                            <field name="format"/>
                            <field name="shopify_webhook_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Timestamps" invisible="not shopify_webhook_id">
                        <group>
                            <field name="created_at"/>
                        </group>
                        <group>
                            <field name="updated_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Webhook Action -->
    <record id="action_shopify_webhook" model="ir.actions.act_window">
        <field name="name">Webhooks</field>
        <field name="res_model">shopify.webhook</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No webhooks configured yet
            </p>
            <p>
                Use <b>Action &#8594; Register All Webhooks</b> to automatically register all
                supported Shopify webhook topics for your active store instances.
                Webhooks enable real-time synchronisation: orders, customers, products,
                inventory, fulfillments, refunds, and more are updated in Odoo the
                moment they change in Shopify.
            </p>
        </field>
    </record>
</odoo>
